{
  "mcpServers": {
    "rabbitwork": {
      "command": "node",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/server/index.mjs"
      ],
      "cwd": "${CURSOR_PLUGIN_ROOT}",
      "env": {
        "RABBITWORK_API_TOKEN": "${RABBITWORK_API_TOKEN}",
        "RABBITWORK_API_BASE_URL": "${RABBITWORK_API_BASE_URL}"
      }
    }
  }
}
