// PhpStorm HTTP Client. Na seta do pedido, escolha o ambiente que você configurou.
// Copie http/http-client.example.env.json para http/http-client.private.env.json
// e preencha host e token. Esse arquivo fica fora do git.
// O servidor precisa estar no ar: node server/http.mjs
//
// Para usar um projeto ou cliente que já existe em todos os pedidos, descomente a linha correspondente.
// Se ficarem comentadas, "Criar cliente" e "Criar projeto" gravam os ids e o restante usa esses valores.
// @projectId = 1
// @customerId = 1
// Cada pedido que envia parâmetro tem as linhas # @... comentadas. Descomente só ali para trocar o valor daquele pedido.
// Os valores abaixo valem enquanto a linha do pedido estiver comentada.
@customerCreateName = Cliente HTTP Client
@projectCreateName = Projeto HTTP Client
// O pedido acrescenta um sufixo aleatório ao nome. Cliente e projeto não podem repetir o nome.
@projectCreatePrivacy = 1
@projectListActive = false
@timeEntryListFrom = 2026-10-06
@timeEntryListTo = 2026-10-12
@detailedReportDateExecutionStart = 2026-10-06
@detailedReportDateExecutionEnd = 2026-10-12
@summaryReportDateExecutionStart = 2026-10-06
@summaryReportDateExecutionEnd = 2026-10-12
@timeEntryCreateDateExecution = 2026-10-14
@timeEntryCreateTimeTotal = 01:00:00
@timeEntryCreateDescription = Exemplo via HTTP Client
@timeEntryEditDescription = Descrição alterada pelo exemplo...
@stopwatchTimeEntryDeleteConfirm = true
@stopwatchTimeEntryDeleteReason = Exemplo do HTTP Client
@projectDeleteConfirm = true
@projectDeleteReason = Exemplo do HTTP Client
@customerDeleteConfirm = true
@customerDeleteReason = Exemplo do HTTP Client
@timesheetSubmitPeriodStart = 2026-10-05
@timesheetSubmitPeriodEnd = 2026-10-11
// "Criar apontamento" grava o id e "Editar" e "Iniciar cronômetro" reutilizam esse id.
// "Iniciar cronômetro" grava o id do cronômetro ativo; "Pausar" e "Apagar apontamento do cronômetro" usam esse id.


### Saúde
GET {{host}}/health

### Initialize
POST {{host}}/mcp
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-06-18",
    "capabilities": {}
  }
}

### Lista de ferramentas
POST {{host}}/mcp
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

### Criar cliente (escreve na conta; grava o id quando @customerId não está definido no topo)
# @customerCreateName=Cliente HTTP Client
POST {{host}}/mcp
Content-Type: application/json
x-api-token: {{token}}

{
  "jsonrpc": "2.0",
  "id": 24,
  "method": "tools/call",
  "params": {
    "name": "create_customer",
    "arguments": {
      "name": "{{customerCreateName}}-{{$random.alphanumeric(6)}}"
    }
  }
}

> {%
var result = response.body.result || {};
var errorText = result.content && result.content[0] && result.content[0].text;
var structured = result.structuredContent && result.structuredContent.item;
var parsed = {};
if (!result.isError && !structured && errorText) {
  try { parsed = JSON.parse(errorText); } catch (e) { parsed = {}; }
}
var item = result.isError ? null : (structured || parsed.item);
var id = item && item.id;
if (result.isError || id == null || id === "") {
  client.log(errorText || "Criação de cliente sem id. Nada foi guardado.");
} else {
  client.global.set("customerId", String(id));
  client.log("customerId guardado: " + id);
}
client.test("cliente criado", function() {
  client.assert(!result.isError, errorText || "A ferramenta retornou erro");
  client.assert(id != null && id !== "", "Resposta sem id de cliente");
});
%}

