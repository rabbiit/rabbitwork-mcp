  "jsonrpc": "2.0",
  "id": 16,
  "method": "tools/call",
  "params": {
    "name": "update_time_entry",
    "arguments": {
      "timeEntryId": {{timeEntryId}},
      "description": "{{timeEntryEditDescription}}"
    }
  }
}

### Iniciar cronômetro (escreve na conta; grava o id do cronômetro ativo)
# @timeEntryId=1
POST {{host}}/mcp
Content-Type: application/json
x-api-token: {{token}}

{
  "jsonrpc": "2.0",
  "id": 17,
  "method": "tools/call",
  "params": {
    "name": "start_stopwatch",
    "arguments": {
      "timeEntryId": {{timeEntryId}}
    }
  }
}

> {%
var result = response.body.result || {};
var errorText = result.content && result.content[0] && result.content[0].text;
var structured = result.structuredContent && result.structuredContent.item;
var parsed = {};
if (!result.isError && !structured && errorText) {
  try { parsed = JSON.parse(errorText); } catch (e) { parsed = {}; }
}
var item = result.isError ? null : (structured || parsed.item);
var id = item && item.id;
if (result.isError || id == null || id === "") {
  client.log(errorText || "Cronômetro sem id. Nada foi guardado.");
} else {
  client.global.set("stopwatchId", String(id));
  client.log("stopwatchId guardado: " + id);
}
client.test("cronômetro iniciado", function() {
  client.assert(!result.isError, errorText || "A ferramenta retornou erro");
  client.assert(id != null && id !== "", "Resposta sem id de cronômetro");
});
%}

