### Criar projeto (escreve na conta; grava o id quando @projectId não está definido no topo)
# @customerId=1
# @projectCreateName=Projeto HTTP Client
# @projectCreatePrivacy=1
POST {{host}}/mcp
Content-Type: application/json
x-api-token: {{token}}

{
  "jsonrpc": "2.0",
  "id": 22,
  "method": "tools/call",
  "params": {
    "name": "create_project",
    "arguments": {
      "name": "{{projectCreateName}}-{{$random.alphanumeric(6)}}",
      "customer_id": {{customerId}},
      "privacy": {{projectCreatePrivacy}}
    }
  }
}

> {%
var result = response.body.result || {};
var errorText = result.content && result.content[0] && result.content[0].text;
var structured = result.structuredContent && result.structuredContent.item;
var parsed = {};
if (!result.isError && !structured && errorText) {
  try { parsed = JSON.parse(errorText); } catch (e) { parsed = {}; }
}
var item = result.isError ? null : (structured || parsed.item);
var id = item && item.id;
if (result.isError || id == null || id === "") {
  client.log(errorText || "Criação de projeto sem id. Nada foi guardado.");
} else {
  client.global.set("projectId", String(id));
  client.log("projectId guardado: " + id);
}
client.test("projeto criado", function() {
  client.assert(!result.isError, errorText || "A ferramenta retornou erro");
  client.assert(id != null && id !== "", "Resposta sem id de projeto");
});
%}

