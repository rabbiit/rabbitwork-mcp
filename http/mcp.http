Content-Type: application/json
x-api-token: {{token}}

{
  "jsonrpc": "2.0",
  "id": 12,
  "method": "tools/call",
  "params": {
    "name": "list_todos",
    "arguments": {
      "project_id": {{projectId}}
    }
