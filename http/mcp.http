POST {{host}}/mcp
Content-Type: application/json
x-api-token: {{token}}

{
  "jsonrpc": "2.0",
  "id": 20,
  "method": "tools/call",
  "params": {
    "name": "stop_stopwatch",
    "arguments": {
      "timeEntryId": {{stopwatchId}}
    }
  }
}

### Apagar apontamento do cronômetro (destrutivo; usa o id do cronômetro ativo)
# @stopwatchId=1
# @stopwatchTimeEntryDeleteConfirm=true
# @stopwatchTimeEntryDeleteReason=Exemplo do HTTP Client
POST {{host}}/mcp
Content-Type: application/json
x-api-token: {{token}}

{
  "jsonrpc": "2.0",
  "id": 21,
  "method": "tools/call",
  "params": {
    "name": "delete_time_entry",
    "arguments": {
      "timeEntryId": {{stopwatchId}},
      "confirm": {{stopwatchTimeEntryDeleteConfirm}},
      "reason": "{{stopwatchTimeEntryDeleteReason}}"
    }
  }
}

> {%
var result = response.body.result || {};
var errorText = (result.content && result.content[0] && result.content[0].text) || "";
var missingConfirm = result.isError && /confirm:\s*true/.test(errorText);
if (missingConfirm) client.log("ALERTA: exclusão recusada porque confirm não está true. " + errorText);
client.test(missingConfirm ? "Alerta: faltou confirmação" : "apontamento do cronômetro apagado", function() {
  client.assert(!result.isError, errorText || "A ferramenta retornou erro");
});
%}

