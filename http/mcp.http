### Criar apontamento (escreve na conta)
# @projectId=1
# @timeEntryCreateDateExecution=2026-10-14
# @timeEntryCreateTimeTotal=01:00:00
# @timeEntryCreateDescription=Exemplo via HTTP Client
POST {{host}}/mcp
Content-Type: application/json
x-api-token: {{token}}

{
  "jsonrpc": "2.0",
  "id": 15,
  "method": "tools/call",
  "params": {
    "name": "create_time_entry",
    "arguments": {
      "project_id": {{projectId}},
      "date_execution": "{{timeEntryCreateDateExecution}}",
      "time_total": "{{timeEntryCreateTimeTotal}}",
      "description": "{{timeEntryCreateDescription}}"
    }
  }
}

> {%
var result = response.body.result || {};
var errorText = result.content && result.content[0] && result.content[0].text;
var structured = result.structuredContent && result.structuredContent.item;
var parsed = {};
if (!result.isError && !structured && errorText) {
  try { parsed = JSON.parse(errorText); } catch (e) { parsed = {}; }
}
var item = result.isError ? null : (structured || parsed.item);
var id = item && item.id;
if (result.isError || id == null || id === "") {
  client.log(errorText || "Criação sem id. Nada foi guardado.");
} else {
  client.global.set("timeEntryId", String(id));
  client.log("timeEntryId guardado: " + id);
}
client.test("apontamento criado", function() {
  client.assert(!result.isError, errorText || "A ferramenta retornou erro");
  client.assert(id != null && id !== "", "Resposta sem id de apontamento");
});
%}

### Editar apontamento (só os campos enviados; usa o id criado acima)
